# =============================================================================
# Promptfoo Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file with actual credentials!
# =============================================================================

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# These credentials are used for:
# 1. The Grader/Judge LLM that evaluates RAG responses
# 2. The LLM that generates responses from retrieved context

# Your Azure OpenAI API key
# Found in: Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_API_KEY=your-azure-openai-api-key-here

# Azure OpenAI endpoint URL
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://ai-40mini.cognitiveservices.azure.com/

# Azure OpenAI API version
# Recommended: Use the latest preview version for newest features
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment name for the chat model
# This should match your Azure deployment name exactly
AZURE_DEPLOYMENT_NAME=gpt-4o-mini

# =============================================================================
# RAG API CONFIGURATION
# =============================================================================
# Configuration for connecting to your local RAG application

# Base URL of your RAG API
# Default: http://localhost:8000
RAG_API_URL=http://localhost:8000

# File ID to query in the RAG system
# This identifies which document(s) to search against
# You can get this from your RAG system after uploading documents
RAG_FILE_ID=your-document-file-id-here

# Number of document chunks to retrieve per query
# Higher = more context but slower and potentially noisier
# Lower = faster but might miss relevant information
# Recommended: 4-6 for most use cases
RAG_TOP_K=4

# Request timeout in seconds
RAG_TIMEOUT=60

# Maximum retry attempts for failed requests
RAG_MAX_RETRIES=3

# =============================================================================
# PROMPTFOO CONFIGURATION
# =============================================================================

# Enable debug logging for Promptfoo
# Set to 1 for verbose output during development
PROMPTFOO_DEBUG=0

# Disable telemetry (optional)
PROMPTFOO_DISABLE_TELEMETRY=1

# Cache directory for Promptfoo results
PROMPTFOO_CACHE_PATH=./promptfoo/.cache

# =============================================================================
# OPTIONAL: EMBEDDING MODEL CONFIGURATION
# =============================================================================
# If your RAG system uses separate embedding credentials

# Embedding model deployment name (if different from chat)
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file with real credentials
# 2. Add .env to your .gitignore
# 3. Use environment-specific .env files (.env.development, .env.production)
# 4. Consider using a secrets manager for production deployments
# 5. Rotate API keys regularly
# 6. Use minimum required permissions for API keys
