# =============================================================================
# Promptfoo Environment Variables
# =============================================================================
# These variables are READ from your main .env file in the project root.
# This file shows which variables the promptfoo integration needs.
# =============================================================================

# =============================================================================
# AZURE OPENAI CONFIGURATION (Already in your main .env)
# =============================================================================
# These should already be set in your main .env file:
# - AZURE_OPENAI_API_KEY
# - AZURE_OPENAI_ENDPOINT
# - RAG_AZURE_OPENAI_API_VERSION
# - AZURE_OPENAI_DEPLOYMENT

# =============================================================================
# RAG-SPECIFIC CONFIGURATION (Add to your main .env)
# =============================================================================

# File ID to query in the RAG system
# This identifies which document(s) to search against
# You get this from your RAG system after uploading documents
RAG_FILE_ID=security-policy-001

# Number of document chunks to retrieve per query
# Higher = more context but slower and potentially noisier
# Lower = faster but might miss relevant information
RAG_TOP_K=4

# Base URL of your RAG API (default works for Docker setup)
RAG_API_URL=http://localhost:8000

# Request timeout in seconds
RAG_TIMEOUT=60

# =============================================================================
# NOTES
# =============================================================================
# The promptfoo integration reads these environment variables:
#
# From your existing .env:
#   AZURE_OPENAI_API_KEY      -> Used for LLM generation and grading
#   AZURE_OPENAI_ENDPOINT     -> Azure endpoint URL
#   RAG_AZURE_OPENAI_API_VERSION -> API version
#   AZURE_OPENAI_DEPLOYMENT   -> Model deployment name (gpt-4o-mini)
#
# You need to ADD to your main .env:
#   RAG_FILE_ID               -> The document file ID to test
#   RAG_TOP_K                 -> Number of chunks to retrieve (optional, default: 4)
